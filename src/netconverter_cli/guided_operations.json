    "zone.map": {
      "assertions": [
        "zone_references_resolve",
        "mapped_zone_present"
      ],
      "decision_fields": [
        "zone_mappings.mappings"
      ],
      "family": "zones",
      "invalidates": [
        "policy",
        "nat",
        "cross_device"
      ],
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,30}$",
            "type": "string"
          }
        },
        "required": [
          "source",
          "target"
        ],
        "type": "object"
      },
      "preparation_supported": true,
      "status": "implemented_awaiting_qualification",
      "title": "Map a source zone"
    }
